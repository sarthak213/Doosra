# Settings for a hosted Doosra (invite-only). Copy to .env.hosted, fill in, and pass with --env-file
# (or set the same names in your host's dashboard). Never commit the filled-in file.

# For a local trial of the container with no sign-in, use instead:  AUTH_MODE=none  SERVE_FRONTEND=1

# --- Sign-in ---------------------------------------------------------------------------------
AUTH_MODE=oauth
# 32+ random characters; signs the session cookie. e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# The public address people use, no trailing slash. OAuth callbacks are PUBLIC_URL/auth/callback/<provider>.
PUBLIC_URL=https://doosra.example.com
# Comma-separated emails that are admins (can manage invites). They can always sign in.
ADMIN_EMAILS=you@example.com

# Register an OAuth app with each provider you want, with the callback above. Leave a pair blank to hide that button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Storage ---------------------------------------------------------------------------------
# Chats, projects, notes and boards. Blank = a SQLite file in the data volume (fine for one instance with a
# persistent disk). For a host with an ephemeral disk or several instances, use Postgres:
#   postgresql://user:password@host:5432/doosra
DATABASE_URL=

# --- The AI ----------------------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Groq is the simplest hosted choice; a local LM Studio is not reachable from a server.
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=
# Questions per user per day (default 30 when hosted; 0 = unlimited) and across everyone (0 = no ceiling).
AI_DAILY_QUESTIONS=30
AI_GLOBAL_DAILY_QUESTIONS=300

# --- Data ------------------------------------------------------------------------------------
# How often to check for a newer published cricket database and swap it in (hours; 0 = never).
DATA_REFRESH_HOURS=24
# Repository whose Releases hold the database (default: the project's own).
# DOOSRA_DATA_REPO=sarthak213/Doosra
# GITHUB_TOKEN=            # optional: lifts GitHub's anonymous rate limit for the download
