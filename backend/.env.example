# Which LLM backend to use: "groq" | "ollama" | "lmstudio"
LLM_PROVIDER=lmstudio

# --- Groq (hosted) --- #
# Get a free key at https://console.groq.com
# GROQ_API_KEY=

# --- Optional overrides --- #
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen/qwen3.5-9b   # a good fit for a laptop GPU; leave reasoning on in LM Studio

# Per-request timeout. Local models need longer (default 180s local, 60s hosted).
# LLM_TIMEOUT_SECONDS=600   # local models: how long to wait for an answer (no retry)

# Qwen3-style models "think" before answering by default: slower, but better at
# picking the right tool and reading results correctly. "off" trades accuracy
# for speed.
# LLM_THINKING=auto   # auto: quick explanations answer directly, saved chats reason first; or on / off
